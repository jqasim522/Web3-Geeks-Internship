# deploy/.env.example
#
# STATUS: CODE-COMPLETE | USER DEPLOYS
# TARGET: Ubuntu 22.04+ with Docker + Docker Compose
# RUN ON USER MACHINE: cp deploy/.env.example deploy/.env && edit deploy/.env with real values
# EXPECTED: docker-compose.yml and the app read these at container start.
#
# WARNING: NEVER commit the real .env file. It is (and must stay) in .gitignore.
# This file lists variable NAMES only — no real values, no real keys.

# ── LLM keys (Day 5 — llm_fallback.py) ────────────────────────────────────────
# Primary tier. Get from https://console.groq.com
GROQ_API_KEY=

# Secondary/fallback tier. Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── STT / voice keys (Day 3 — voice_pipeline.py, voice_providers.py) ─────────
# Speech-to-text for Roman Urdu / Urdu input. Only needed if voice input mode
# is enabled in production; text mode does not require these.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Text-to-speech. Fish Audio is primary; Edge TTS is the free fallback and
# needs no key (see docs/TROUBLESHOOTING.md for the Fish Audio 402 case).
FISH_AUDIO_API_KEY=

# ── Google OAuth / Calendar / Gmail (Day 4 — calendar_client.py,
#    email_client.py, google_auth.py) ─────────────────────────────────────────
# Path INSIDE the container to the OAuth credentials JSON (mount it as a
# volume in docker-compose.yml rather than baking it into the image).
GOOGLE_CALENDAR_CREDENTIALS_PATH=/app/secrets/google_credentials.json

# App password for the Gmail account sending booking confirmations
# (https://myaccount.google.com/apppasswords) — NOT the account's login password.
GMAIL_APP_PASSWORD=
GMAIL_SENDER_ADDRESS=

# ── Application ────────────────────────────────────────────────────────────
# Path to the SQLite listings DB, inside the container.
DATABASE_PATH=/app/data/realestate.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Port the app listens on inside the container (matches docker-compose.yml
# and nginx.conf's upstream).
APP_PORT=8000

# ── Deployment (used by nginx.conf and deploy.sh, not by the app itself) ─────
# Your real domain, e.g. voiceagent.example.com — used for nginx server_name
# and the Certbot SSL request. Replace YOUR_DOMAIN.com in deploy/nginx.conf too.
DOMAIN_NAME=YOUR_DOMAIN.com

# Email Certbot uses for Let's Encrypt renewal notices.
CERTBOT_EMAIL=
