@'
# Secrets — never commit
.env
**/.env
secrets/
**/token.json
**/credentials.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/

# Data that should not be committed
data/*.pkl
data/backups/
results/*.jsonl
*.log

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/
*.egg-info/
'@ | Set-Content -Path .\.gitignore -Encoding UTF8